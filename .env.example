# Copie para .env e ajuste. O .env não é versionado.

# Versão da imagem oficial PKP (pkpofficial/ojs). 3.5.0-x é a linha LTS.
OJS_VERSION=3_5_0-5

# Use a mesma versão de MySQL do servidor compartilhado (ex.: mysql:8.0, mysql:5.7).
DB_IMAGE=mysql:8.0
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_PORT=3307

SERVERNAME=localhost
HTTP_PORT=8080

# Administrador do site no ambiente LOCAL (usado por scripts/install.ps1).
OJS_ADMIN_USER=admin
OJS_ADMIN_PASSWORD=troque-esta-senha-admin
OJS_ADMIN_EMAIL=admin@csvet.com.br
