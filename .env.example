# Copy to .env and change the values before deploying
DB_PASSWORD=secure_db_pass
FINGERPRINT_SALT=change_me_to_a_long_random_string
WEB_PORT=3080
# Reverse proxies in front of the API (host Nginx + web container). Use 1 if there is no host proxy.
TRUST_PROXY_HOPS=2
# Accounts: e-mails that always get the admin role (comma separated). Register with this e-mail on the site.
ADMIN_EMAILS=
# YouTube Data API v3 (Google Cloud Console); restrict it to that API. Empty = tutorials disabled
YOUTUBE_API_KEY=

# Login with Google / Discord (D-39). Redirect URI to register with each provider:
#   <PUBLIC_URL>/api/auth/oauth/google/callback  and  <PUBLIC_URL>/api/auth/oauth/discord/callback
# Production: PUBLIC_URL=https://bagparser.com   Local: PUBLIC_URL=http://localhost:3080 (open the site on localhost)
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Session cookie Secure flag: auto (follows HTTPS from the proxy), true or false
COOKIE_SECURE=auto

# Cloudflare Turnstile (Anti-Bot)
# Site key is in the frontend: 0x4AAAAAAF1L8qttgfKwIY_H
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=bagparser.com,localhost,127.0.0.1

# Stripe (D-51): every charge goes through Stripe (no Mercado Pago). Webhook endpoint: https://bagparser.com/api/billing/webhook
# events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid
# Optional Price ids (else inline prices R$ 9,90 / R$ 89,90 / US$ 2.49 / US$ 19.99): STRIPE_PRICE_PRO_BRL_MONTHLY, _BRL_YEARLY, _USD_MONTHLY, _USD_YEARLY
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# D-65: e-mail for "forgot password" and notices (SMTP with TLS on 465). Put the real password ONLY in the server .env.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
# MAIL_LOG=1 prints e-mails to the API log instead of sending (local development only, without SMTP_HOST)
MAIL_LOG=

# D-66: Google AdSense for free users (Pro is ad-free). Leave empty until Google approves the site.
# ADSENSE_CLIENT defaults to the BagParser publisher id (docker-compose.yml); set only to override
ADSENSE_CLIENT=
ADSENSE_SLOT=

# D-69: Pix via Mercado Pago (Checkout Transparente). Access Token of production credentials + "assinatura secreta" of the webhook.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# orders (default, recommended by Mercado Pago) or payments
MP_API_MODE=

# D-75: Telegram bot (token from @BotFather). Production: only the token (webhook at PUBLIC_URL/api/telegram/webhook).
# Local tests: use a SEPARATE test bot with TELEGRAM_POLLING=1 (polling removes that bot's webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=
