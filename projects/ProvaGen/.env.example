# Database
DATABASE_URL=mysql://user:password@localhost:3306/provagen

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-here
SITE_BASE=https://www.prof-aid.com
VITE_SITE_BASE=https://www.prof-aid.com

# OAuth
OAUTH_SERVER_URL=http://localhost:3000

# Owner configuration
OWNER_OPEN_ID=local:admin@example.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AWS S3 Configuration (optional)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_REGION=us-east-1

# Built-in Forge API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# reCAPTCHA Security (optional - leave empty to disable)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
