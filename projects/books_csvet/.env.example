# Copie para .env e ajuste. O .env não é versionado.

# Versão da imagem oficial PKP (pkpofficial/omp). 3.5.0-x é a linha LTS.
OMP_VERSION=3_5_0-5

# Use a mesma versão de MySQL do servidor compartilhado (ex.: mysql:8.0, mysql:5.7).
DB_IMAGE=mysql:8.0
DB_NAME=omp
DB_USER=omp
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
# Portas diferentes das do journals (8080/3307) para os dois ambientes rodarem juntos
DB_PORT=3308

SERVERNAME=localhost
HTTP_PORT=8081

# Administrador do site no ambiente LOCAL (usado por scripts/setup.ps1).
OMP_ADMIN_USER=admin
OMP_ADMIN_PASSWORD=troque-esta-senha-admin
OMP_ADMIN_EMAIL=admin@csvet.com.br
