msgid "plugins.generic.csvetEditorial.name"
msgstr "Editora CSVET: regras editoriais"

msgid "plugins.generic.csvetEditorial.description"
msgstr "Termo de submissão obrigatório com registro de aceite, créditos de orientação e banca fora da autoria e e-mails com a identidade da editora."

msgid "plugins.generic.csvetEditorial.terms.label"
msgstr "Termo de submissão, originalidade e direitos autorais"

msgid "plugins.generic.csvetEditorial.terms.agree"
msgstr "Li e aceito o termo acima em meu nome e em nome de todos os autores, organizadores e contribuidores cadastrados."

msgid "plugins.generic.csvetEditorial.terms.required"
msgstr "Para submeter, é preciso ler e aceitar o termo de submissão, originalidade e direitos autorais."

msgid "plugins.generic.csvetEditorial.terms.log"
msgstr "Termo de submissão aceito eletronicamente por {$name} (usuário {$username}, {$email}) em {$date}, IP {$ip}, navegador \"{$agent}\". Versão do termo {$version} (SHA-256 {$hash})."

msgid "plugins.generic.csvetEditorial.email.footer"
msgstr "<strong style=\"color:#ffffff;\">Editora CSVET</strong> · CSVET Editora, Cursos e Treinamentos · CNPJ 32.645.724/0001-89 · Americana, SP · contato@csvet.com.br"

msgid "plugins.generic.csvetEditorial.email.notice"
msgstr "Mensagem enviada pela plataforma editorial. Obras em avaliação são confidenciais: não encaminhe nem compartilhe este conteúdo."
