# App
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=plumora_user
DB_PASSWORD=plumora_pass
DB_NAME=plumora

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / Storage
MINIO_URL=http://localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=plumora-uploads

# E-mail (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key
EMAIL_FROM=noreply@plumora.com.br

# Mercado Pago (billing — leave empty for dev; falls back gracefully but nothing is really charged)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail marketing (campanhas em massa via Gmail — provedor separado do Resend acima)
# GMAIL_APP_PASSWORD é a "senha de app" do Google (Conta Google > Segurança > Senhas de app),
# não a senha normal — só funciona se a conta tiver 2FA ativado.
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
MARKETING_DAILY_LIMIT=450
